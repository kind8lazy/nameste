# Скопируйте в .env и при необходимости поменяйте. Секретов здесь нет —
# ключи уведомлений (VAPID) сервер создаёт сам и хранит в data/.
PORT=3000
HOST=127.0.0.1
DATA_DIR=data
# Адрес, по которому приложение открывают снаружи (нужен для ссылок и уведомлений)
PUBLIC_URL=http://localhost:5173
# Контакт для службы уведомлений: https-адрес сервиса или mailto:
VAPID_SUBJECT=https://na-meste.invalid
# Бесплатные сервисы карт (можно заменить своими серверами)
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
