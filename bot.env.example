# Настройки Телеграм-бота для заявок. Скопируйте в bot.env и заполните. В git bot.env не попадает.
# Подробно — docs/TELEGRAM-BOT.md

# Токен от @BotFather (команда /newbot)
TELEGRAM_BOT_TOKEN=

# Кому присылать заявки в Телеграм: номера чатов через запятую. Узнать номер — напишите боту /id
TELEGRAM_ADMIN_CHAT_IDS=

# Куда передавать заявки, чтобы они появлялись во «Входящих» диспетчера.
# LEADS_SECRET — та же строка, что в secrets.env на сервере. Можно оставить пустыми — тогда заявки только в Телеграм.
APP_URL=https://na-meste-spb.ru
LEADS_SECRET=

# Если Телеграм напрямую недоступен — адрес своего прокси к Bot API (необязательно)
# TELEGRAM_API_URL=https://api.telegram.org
