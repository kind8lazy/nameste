# Скопируйте этот файл как secrets.env и вставьте свои данные. В git и в переписку они не попадают.

# ——— Вход через Яндекс ID — приложение создаётся на https://oauth.yandex.ru
# Доступы приложения: имя и логин, почта, номер телефона
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# ——— Письма «ребёнок на месте» на Яндекс Почту родителя
# Отправляются с вашего ящика на Яндексе. SMTP_PASS — это «пароль приложения» для почты
# (Яндекс ID → Безопасность → Пароли приложений → Почта), а не пароль от аккаунта.
MAIL_PROVIDER=smtp
SMTP_USER=
SMTP_PASS=
# Какие события слать письмом: handed_over — «ребёнок на месте»; можно добавить boarded,no_show,cancelled
MAIL_EVENTS=handed_over

# Ваш телефон: при первом входе через Яндекс этот номер получит права диспетчера и водителя
ADMIN_PHONES=

# ——— SMS выключены. Если понадобятся: SMS_PROVIDER=yandex (ключи YC_SMS_KEY_ID, YC_SMS_SECRET)
# или SMS_PROVIDER=smsru (ключ SMSRU_API_ID)
SMS_PROVIDER=none
